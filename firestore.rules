rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // La aplicación usa Authentication anónima para identificar cada dispositivo.
    // Todos los dispositivos autenticados de esta aplicación comparten el estado del gimnasio.
    // Para una instalación pública con varios gimnasios, sustituir estas reglas por reglas por usuario/rol.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
  }
}
